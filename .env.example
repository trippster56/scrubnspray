# ── Better Auth (admin login) ────────────────────────
# Required for admin login. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
# Public URL where auth callbacks resolve. http://localhost:3000 in dev.
BETTER_AUTH_URL=http://localhost:3000

# ── Neon Postgres (database) ──────────────────────────
# Get a connection string from https://console.neon.tech (or the Vercel
# Marketplace, which injects this automatically). Optional in dev — without
# it, forms log to the console and still return success, but admin is disabled.
DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Resend (email notifications) ──────────────────────
# Get an API key from https://resend.com. Optional in dev — without it, form
# submissions log to the console instead of emailing.
RESEND_API_KEY=re_xxxxxxxxxxxxx
# A verified sender on scrubnspray.com once the domain is set up in Resend.
RESEND_FROM_EMAIL=contact@scrubnspray.com
# Where contact-form notifications go.
RESEND_TO_EMAIL=info@scrubnspray.com
# Where refund/lost-money claims go (falls back to RESEND_TO_EMAIL if unset).
RESEND_CLAIMS_EMAIL=claims@scrubnspray.com
